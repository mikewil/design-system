{
    "compilerOptions": {
        "baseUrl": ".",
        "composite": true,
        "declaration": true,
        "skipLibCheck": true,
        "strict": true,
        "module": "esnext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "target": "es6",
        "jsx": "react-jsx",
        "strictBindCallApply": true,
        "types": ["node"],
        "paths": {}
    },
    "exclude": ["node_modules", "dist", "lib"],
    "include": ["packages/*/src/**/*"]
}