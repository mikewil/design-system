{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "lib",
        "rootDir": "src",
        "paths": {
            "@interfaces/*": ["src/interfaces/*"]
        },
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/global.d.ts"],
    "exclude": [
        "node_modules",
        "**/__tests__/*",
        "**/*.stories.tsx",
        "src/**/*.test*",
        "src/__mocks__"
    ]
}
