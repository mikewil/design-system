    "test": "jest --coverage",
    "test:watch": "jest --config jest.config.js --watchAll --collectCoverage",
    "test:ci": "npm run test -- --watchAll=false --reporters=default --reporters=jest-junit --collectCoverage",
    "lint-staged": "lint-staged src",
    "lint": "eslint src --ext js,ts,tsx",
