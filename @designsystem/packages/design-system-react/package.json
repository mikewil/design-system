{
  "name": "@designsystem/design-system-react",
  "version": "1.13.1",
  "description": "Repo for the Design System",
  "files": [
    "lib/**/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "minify": "jsmin --overwrite ./lib/index.js",
