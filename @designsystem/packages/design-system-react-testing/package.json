    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.14",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "eslint-config-prettier": "^9.1.0",
