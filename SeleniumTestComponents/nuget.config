<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<add key="DesignSystem" value="https://pkgs.dev.azure.com/DesignSystem/_packaging/0321420e-9ec7-43f0-860b-2976ee08b3b8/nuget/v3/index.json" />
	</packageSources>

	<!-- Define mappings by adding package patterns beneath the target source. -->
	<!-- DesignSystem.* packages will be restored from Azure DevOps,
       everything else from nuget.org. -->
	<packageSourceMapping>
		<!-- key value for <packageSource> should match key values from <packageSources> element -->
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="DesignSystem">
			<package pattern="DesignSystem.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
